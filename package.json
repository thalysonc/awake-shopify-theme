{
	"name": "shopify-starter-kit-theme",
	"version": "1.0.0",
	"description": "Shopify Starter Kit Theme",
	"main": "index.js",
	"scripts": {
		"format": "prettier --write .",
		"css": "npx postcss --verbose src/css/theme.css -o assets/theme.css",
		"js": "parcel build src/scripts/app.js --no-source-maps --out-dir ./assets --out-file bundle.js",
		"dev": "concurrently \"parcel watch src/scripts/app.js --no-hmr --out-dir ./assets --out-file bundle.js\" \"npx postcss src/css/theme.css -o assets/theme.css --watch\" \"shopify theme dev --store=th-cordeiro-bootcamp.myshopify.com\" "
	},
	"author": "Luiz Venturote",
	"dependencies": {
		"api": "^6.1.3",
		"autoprefixer": "^10.4.4",
		"tabbable": "^6.0.0",
		"tailwindcss": "^3.0.23"
	},
	"devDependencies": {
		"@shopify/prettier-plugin-liquid": "^1.8.0",
		"@tailwindcss/forms": "^0.5.0",
		"@tailwindcss/typography": "^0.5.2",
		"concurrently": "^7.6.0",
		"cssnano": "^6.0.1",
		"parcel-bundler": "^1.12.5",
		"postcss": "^8.4.27",
		"postcss-cli": "^9.1.0",
		"postcss-import": "^14.1.0",
		"postcss-nesting": "^10.1.3",
		"prettier": "^3.5.1"
	}
}
