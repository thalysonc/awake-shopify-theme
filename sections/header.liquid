      </div>

      <div class="flex gap-5 items-center justify-end w-1/3">

        <button class="h-5 w-5 hidden laptop:block">{% render 'icon-search' %}</button>

        <button class="h-5 w-5">{% render 'icon-user' %}</button>

        <button class="h-5 w-5 hidden laptop:block">{% render 'icon-heart' %}</button>

        <button class="flex items-center gap-[6px]">
          <span class="h-5 w-5">{% render 'icon-cart' %}</span>
