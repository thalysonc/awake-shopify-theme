      <ul class="flex flex-wrap gap-1 [&>li:not(:last-child)]:after:content-['|'] [&>li:not(:last-child)]:after:ml-1">
        {%- for link in linklists.footer-links.links -%}
          <li>
            <a href="{{ link.url }}" class="underline">{{ link.title }}</a>
